{
  "name": "personal-blog-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite --host 0.0.0.0",
    "build": "npm run content && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/start.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:unit": "vitest run",
    "test:layout": "node scripts/check-layout.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
